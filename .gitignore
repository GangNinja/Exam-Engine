# Downloaded third-party datasets: keep originals out of version control unless
# their licence clearly permits redistribution.
datasets/external/

# Personal examination corpus: read it in place, never redistribute it.
datasets/GATE/
datasets/BOARD EXAMS/
datasets/JEE Advanced/
datasets/JEE Mains/
datasets/NEET/

# Local database backups and generated dataset projections.
/backups/
/dataset_final*/

# Scratch files, agent work areas and imported attachments.
/tmp_*
/work/
/.cloud-attachments/

# Generated reports and one-off documentation snapshots. README and the
# maintained phase 1-12 notes remain tracked; phase 13 notes already in the
# repository are left untouched.
/reports/
/PHASE_*.md
/docs/phase-13-*.md
/docs/phase-14*.md

# Tool/agent state that is specific to this machine.
.freebuff/
.tmp-hairline/

# Generated reports and coverage artefacts from the quickstart commands.
reports/
coverage.xml
.coverage.*

# Browser dependencies are installed from the lockfile, never committed.
node_modules/

# SQLite side files beyond the database that is already ignored above.
*.db-journal
*.sqlite3

# Operating-system and editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local server logs and browser-test artefacts.
*.log
frontend/test-results/
frontend/playwright-report/
test-results/
playwright-report/
